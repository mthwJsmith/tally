# Required
TALLY_MASTER_KEY=         # `openssl rand -base64 32` — encrypts OAuth tokens at rest
TALLY_FIREFLY_URL=http://firefly-iii:8080
TALLY_FIREFLY_TOKEN=      # Firefly III Personal Access Token (Profile → OAuth)
TALLY_TRUELAYER_CLIENT_ID=
TALLY_TRUELAYER_CLIENT_SECRET=
TALLY_REDIRECT_URI_BASE=https://tally.example.com/auth   # your public TrueLayer redirect host

# MCP connector auth — external OIDC authorization server (Authentik / Keycloak).
# tally validates the IdP's JWTs on /mcp; it does NOT run its own OAuth server, and there is
# NO API-token fallback on /mcp. If these are unset, /mcp is disabled (401 for all callers).
# TALLY_OIDC_ISSUER=https://auth.example.com/application/o/tally/
# TALLY_OIDC_AUDIENCE=tally-mcp
# TALLY_OIDC_JWKS_URL=                 # optional; defaults to <issuer>/jwks/

# Set when tally is served over HTTPS (adds Secure to the session cookie).
# TALLY_SECURE_COOKIES=true

# Optional
TALLY_PORT=3001
TALLY_DATABASE_URL=sqlite:///app/data/state.db
TALLY_SYNC_CRON="0 7 * * * *"      # 6-field cron; this = every hour at :07

# Deal watchlist: optional changedetection.io for per-product-URL price tracking.
# RSS feeds (HotUKDeals / CamelCamelCamel) work without this; these enable URL scraping.
# See docker-compose.deals.yml. If unset, the watchlist just uses RSS sources.
# TALLY_CHANGEDETECTION_URL=http://changedetection:5000
# TALLY_CHANGEDETECTION_API_KEY=          # changedetection Settings → API

# Optional notification hooks (silently disabled if unset)
# TALLY_HA_URL=http://homeassistant:8123
# TALLY_HA_TOKEN=                  # HA long-lived access token
# TALLY_TELEGRAM_BOT_TOKEN=
# TALLY_TELEGRAM_CHAT_ID=
# TALLY_TELEGRAM_MIN_AMOUNT=0       # only notify on |amount| ≥ this
